# ── RIVAL API ────────────────────────────────────────────────────────────
# Copy to .env and fill in. Never commit a real .env; nothing here ships to
# the mobile or web bundles — the clients only ever see API_URL.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://postgres@localhost:5432/rival

# Signing secret for access/refresh tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60

# Public origin, used to build verification and password-reset links.
PUBLIC_APP_URL=http://localhost:3000

# ── OAuth ────────────────────────────────────────────────────────────────
# Verification is provider-agnostic (see src/auth/oauth.ts). Leave blank to
# disable a provider; the endpoint then returns 501 rather than half-working.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Email ────────────────────────────────────────────────────────────────
# `console` prints the link to the server log, for local development.
MAIL_TRANSPORT=console
MAIL_FROM=no-reply@rival.app

# ── Payments ─────────────────────────────────────────────────────────────
# The provider is data, not code: stripe | revenuecat | apple | google | none.
# Each deployment picks one; the API stores the provider on the subscription.
PAYMENT_PROVIDER=none
PAYMENT_WEBHOOK_SECRET=

# ── Push notifications ───────────────────────────────────────────────────
# expo | fcm | none
PUSH_TRANSPORT=none
EXPO_ACCESS_TOKEN=
FCM_SERVER_KEY=
