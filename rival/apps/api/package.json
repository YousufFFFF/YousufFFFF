{
  "name": "@rival/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --dry && tsc -p tsconfig.json --noEmit",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node --experimental-strip-types src/db/migrate.ts",
    "seed": "node --experimental-strip-types src/db/seed.ts",
    "seed:demo": "node --experimental-strip-types src/db/seed-demo.ts",
    "test": "node --test --test-reporter=spec --test-concurrency=1 --experimental-strip-types test/*.test.ts",
    "prepare:core": "tsc -b ../../packages/core",
    "predev": "tsc -b ../../packages/core",
    "pretest": "tsc -b ../../packages/core",
    "premigrate": "tsc -b ../../packages/core",
    "preseed": "tsc -b ../../packages/core",
    "prestart": "tsc -b ../../packages/core"
  },
  "dependencies": {
    "@rival/core": "*",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
